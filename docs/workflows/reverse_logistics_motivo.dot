digraph reverse_logistics {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.45, fontname="Arial", fontsize=13, labelloc=t, pad=0.3, newrank=true];
  node [fontname="Arial", fontsize=11, color="#263238", margin="0.14,0.08"];
  edge [fontname="Arial", fontsize=9.5, color="#263238", fontcolor="#263238"];
  inicio [label="Card returned\nto the seller", shape=box, style="rounded,filled", fillcolor="#263238", fontcolor="white"];
  why [label="Reason\nfor return?", shape=diamond, style=filled, fillcolor="white"];
  subgraph cluster_1 {
    label="Withdrawal"; style="rounded,dashed"; color="#263238"; fontsize=12;
    r1 [label="Re-inspection\n(unused card)", shape=box, style="filled", fillcolor="white"];
    r2 [label="Stock", shape=cylinder, style=filled, fillcolor="#eceff1"];
  }
  subgraph cluster_2 {
    label="Defect"; style="rounded,dashed"; color="#263238"; fontsize=12;
    d1 [label="Failure analysis\ntied to engraved lot", shape=box, style="filled", fillcolor="white"];
    d2 [label="Process and\ninspection fix", shape=box, style="filled", fillcolor="white"];
  }
  subgraph cluster_3 {
    label="End of life"; style="rounded,dashed"; color="#263238"; fontsize=12;
    e1 [label="Reverse logistics\n(next diagram)", shape=box, style="filled", fillcolor="#ef6c00", fontcolor="white"];
  }
  inicio -> why;
  why -> r1 [label="withdrawal\n(within 7 days,\nCDC art. 49)"];
  why -> d1 [label="defect\n(warranty,\nCDC art. 26)"];
  why -> e1 [label="end of life\n(voluntary)"];
  r1 -> r2 [label="intact"];
  d1 -> d2 [label="root cause"];
}
